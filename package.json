{
  "name": "@meltbead/bead-colors-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for craft color palettes and perceptual screen-color matching",
  "type": "module",
  "license": "(MIT AND CC-BY-4.0)",
  "bin": {
    "bead-colors-mcp": "./src/index.js"
  },
  "files": ["src/", "scripts/", "data/", "README.md", "DATA_SOURCES.md", "LICENSE-DATA.md", "LICENSE"],
  "scripts": {
    "start": "node src/index.js",
    "build:csv": "node scripts/build-csv.js",
    "check:csv": "node scripts/build-csv.js --check",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@meltbead/bead-colors": "0.2.0",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "publishConfig": { "access": "public" }
}
